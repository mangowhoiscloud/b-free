#cloud-config
%{ if !cis_preconditions ~}
# S1 4a DEMO ONLY (cis_preconditions = false): no CIS sysctls, no etcd user. RKE2 profile: cis must refuse to start.
%{ endif ~}
# Common RKE2 node cloud-init (spec FR-3, §7.2, T2: "RKE2 ... 플랫폼 · 온프렘 공용 cloud-init으로 설치").
# One document for the on-prem Lima VMs and the platform EC2 node; rendered by
# infra/modules/cluster/onprem/cloud-init (role=${role}). No secret in it: the agent join token
# is generated on the server and piped to agents at join time, never put in user-data.
# CIS conditions fixed here: kernel sysctls, the etcd user and group (servers), PSA config,
# audit policy, profile: cis. Sleep and power-save targets are masked (spec T2).
write_files:
  - path: /etc/sysctl.d/60-rke2-cis.conf
    permissions: "0644"
    content: |
%{ if cis_preconditions ~}
      vm.panic_on_oom=0
      vm.overcommit_memory=1
      kernel.panic=10
      kernel.panic_on_oops=1
%{ endif ~}
      fs.inotify.max_user_instances=8192
      fs.inotify.max_user_watches=524288
  # Ceph RBD through rbd-nbd (the kernel 6.8 krbd cannot use Ceph Tentacle keys).
  - path: /etc/modules-load.d/bravo-nbd.conf
    permissions: "0644"
    content: |
      nbd
  - path: /etc/modprobe.d/bravo-nbd.conf
    permissions: "0644"
    content: |
      options nbd nbds_max=64
  - path: /etc/rancher/rke2/config.yaml
    permissions: "0600"
    content: |
      # bravo RKE2 ${role} (common cloud-init). Node address: config.yaml.d/10-node.yaml (runtime).
      profile: cis
      protect-kernel-defaults: true
      write-kubeconfig-mode: "0600"
      kubelet-arg:
        - streaming-connection-idle-timeout=5m
        - event-qps=0
%{ if role == "server" ~}
      # CNI: none here; the landing zone installs its own Cilium (same version on every environment, D-23).
      cni: none
      disable-kube-proxy: true
      disable: [rke2-ingress-nginx, rke2-traefik]
      secrets-encryption: true
      agent-token-file: /etc/rancher/rke2/agent-token
      pod-security-admission-config-file: /etc/rancher/rke2/psa.yaml
      audit-policy-file: /etc/rancher/rke2/audit-policy.yaml
      kube-apiserver-arg:
        - audit-log-maxage=30
        - audit-log-maxbackup=10
        - audit-log-maxsize=100
      tls-san: [${join(", ", tls_sans)}]
%{ endif ~}
%{ if role == "server" ~}
  - path: /etc/rancher/rke2/psa.yaml
    permissions: "0600"
    content: |
      apiVersion: apiserver.config.k8s.io/v1
      kind: AdmissionConfiguration
      plugins:
        - name: PodSecurity
          configuration:
            apiVersion: pod-security.admission.config.k8s.io/v1
            kind: PodSecurityConfiguration
            defaults: {enforce: restricted, enforce-version: latest, audit: restricted, audit-version: latest, warn: restricted, warn-version: latest}
            exemptions: {usernames: [], runtimeClasses: [], namespaces: [kube-system]}
  - path: /etc/rancher/rke2/audit-policy.yaml
    permissions: "0600"
    content: |
      apiVersion: audit.k8s.io/v1
      kind: Policy
      omitStages: [RequestReceived]
      rules:
        - {level: None, nonResourceURLs: ["/healthz*", "/livez*", "/readyz*", "/version", "/metrics"]}
        - {level: None, users: ["system:apiserver"], verbs: [get, list, watch]}
        - {level: None, resources: [{group: coordination.k8s.io, resources: [leases]}], verbs: [get, update, watch]}
        - level: Metadata
          resources:
            - {group: "", resources: [secrets, configmaps, serviceaccounts/token]}
            - {group: authentication.k8s.io, resources: [tokenreviews]}
        - {level: Metadata, resources: [{group: "", resources: [pods/exec, pods/portforward, pods/attach]}]}
        - level: Request
          verbs: [create, update, patch, delete, deletecollection]
          resources: [{group: rbac.authorization.k8s.io}, {group: networking.k8s.io}, {group: cilium.io}, {group: kyverno.io}, {group: policies.kyverno.io}]
        - level: Metadata
%{ endif ~}
  - path: /usr/local/sbin/bravo-rke2-bootstrap.sh
    permissions: "0700"
    content: |
      #!/bin/sh
      # Install the pinned RKE2 and start it. Idempotent; safe to re-run after fixing a CIS condition.
      set -eu
      ROLE=${role}; VER='${rke2_version}'; SHA=${rke2_sha256}; ARCH=${arch}; NODE_NAME='${node_name}'
      log() { echo "bravo-rke2-bootstrap[$ROLE]: $*"; }
      # Enable and start apart: `systemctl enable --now` exits 0 even when the start fails (systemd 255 on
      # Ubuntu 24.04, measured 2026-11-02), so a CIS refusal went unreported. A refused start fails here at once.
      start_unit() {
        systemctl enable "$1.service"
        systemctl start "$1.service" && return 0
        log "$1 did not start. Last errors from its journal:"
        journalctl -u "$1" --no-pager -o cat -n 300 | grep -E 'level=(fatal|error)' | tail -n 5 \
          || journalctl -u "$1" --no-pager -o cat -n 10
        exit 1
      }
      # CIS host conditions.
      sysctl --system >/dev/null
      modprobe nbd 2>/dev/null || log "nbd module not loaded (RBD rbd-nbd mounts will fail)"
%{ if cis_preconditions ~}
      if [ "$ROLE" = server ]; then
        getent group etcd >/dev/null || groupadd --system etcd
        id etcd >/dev/null 2>&1 || useradd --system --no-create-home --gid etcd --shell /sbin/nologin --comment "etcd user" etcd
      fi
%{ else ~}
      log "S1 4a demo: CIS preconditions left out (cis_preconditions = false): no CIS sysctls, no etcd user"
%{ endif ~}
      # No sleep or power-save on a cluster node.
      systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target >/dev/null 2>&1 || true
      # Node address: lima0 (Lima user-v2 as second NIC), else the default-route source address.
      IP=$(ip -4 -o addr show dev lima0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)
      [ -n "$IP" ] || IP=$(ip -4 route show default | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1)}' | head -n1)
      [ -n "$IP" ] && [ "$IP" != 192.168.5.15 ] || { log "no usable node address"; exit 1; }
      install -d -m 0700 /etc/rancher/rke2/config.yaml.d
      { echo "node-ip: $IP"; [ -z "$NODE_NAME" ] || echo "node-name: $NODE_NAME"
        [ "$ROLE" != server ] || { echo "advertise-address: $IP"; echo "tls-san+: [$IP]"; }; } > /etc/rancher/rke2/config.yaml.d/10-node.yaml
      chmod 0600 /etc/rancher/rke2/config.yaml.d/10-node.yaml
      # Pinned RKE2: tarball verified against the SHA-256 from the release's sha256sum-$ARCH.txt.
      if ! /usr/local/bin/rke2 --version 2>/dev/null | grep -qF "$VER"; then
        url="https://github.com/rancher/rke2/releases/download/$(echo "$VER" | sed 's/+/%2B/')/rke2.linux-$ARCH.tar.gz"
        curl -fsSL --retry 5 -o /tmp/rke2.tgz "$url"
        echo "$SHA  /tmp/rke2.tgz" | sha256sum -c -
        tar -xzf /tmp/rke2.tgz -C /usr/local && rm -f /tmp/rke2.tgz
        systemctl daemon-reload
      fi
      log "$(/usr/local/bin/rke2 --version | head -n1), node-ip $IP"
      if [ "$ROLE" = server ]; then
        [ -s /etc/rancher/rke2/agent-token ] || (umask 077; od -An -tx1 -N32 /dev/urandom | tr -d ' \n' > /etc/rancher/rke2/agent-token)
        # Packaged Traefik CRD chart: disabling rke2-traefik does not stop it, and it collides with the landing-zone
        # Gateway API CRDs (helm-install-rke2-traefik-crd CrashLoop). A .skip file stops a packaged manifest.
        install -d -m 0700 /var/lib/rancher/rke2/server
        install -d -m 0755 /var/lib/rancher/rke2/server/manifests
        touch /var/lib/rancher/rke2/server/manifests/rke2-traefik-crd.yaml.skip
        start_unit rke2-server
      else
        # Joins when the platform has piped the server URL and token into 20-join.yaml (no token in user-data).
        if [ -s /etc/rancher/rke2/config.yaml.d/20-join.yaml ]; then start_unit rke2-agent
        else systemctl enable rke2-agent.service >/dev/null 2>&1; log "waiting for /etc/rancher/rke2/config.yaml.d/20-join.yaml"; fi
      fi
runcmd:
  - [/usr/local/sbin/bravo-rke2-bootstrap.sh]
