# Settings for deploy/pilot/compose.app.yaml. Pass after the pilot .env:
#   docker compose -p bravo-pilot --env-file .env --env-file ../../apps/demo/pilot-app.env \
#     -f compose.yaml -f compose.app.yaml up -d --build app-src app-dst
# Create apps/demo/pilot-app.env (gitignored) with scripts/render-pilot-env.sh, which copies this
# file and fills the bucket values from the Terraform outputs. Never type bucket names here by hand.
APP_SRC_HOST_PORT=8090
APP_DST_HOST_PORT=8091
# Optional: the URL phones should open (QR). Default: the URL the browser used.
APP_SRC_PUBLIC_URL=
APP_DST_PUBLIC_URL=
APP_WRITE_WAIT_S=8
APP_POLL_INTERVAL_S=0.5

# Write-block switch (spec r2 §8.10): admin listeners, published on 127.0.0.1 only.
APP_SRC_ADMIN_HOST_PORT=18081
APP_DST_ADMIN_HOST_PORT=18082
APP_WRITE_BLOCK_RETRY_AFTER_S=1
# The Bearer token is NOT set here. Export it in the shell from OpenBao (pipe, no file), e.g.
#   export APP_ADMIN_TOKEN="$(<read secret/envs/<env>/chat-admin field token>)"
# Compose needs the variable to exist; exported empty or shorter than 32 characters, the admin API
# refuses every request (fail closed) while the chat keeps working.

# Source app -> Amazon S3. From `terraform -chdir=infra/envs/source-aws output`:
#   attachments_bucket, attachments_bucket_region. Empty bucket = attachments off.
# Credentials: AWS default chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
# exported in the shell, short-lived). The bucket policy must allow that principal.
APP_SRC_S3_BUCKET=
APP_SRC_S3_REGION=
APP_SRC_S3_ENDPOINT_URL=
APP_SRC_S3_ADDRESSING_STYLE=virtual
APP_SRC_STORE_ID=src

# Destination app -> Rook-Ceph RGW on the on-prem K3s landing zone. From infra/envs/target-onprem
# (outputs attachments_bucket, attachments_bucket_region, attachments_endpoint) when it exists.
# The RGW user keys come from the landing zone Secret; empty bucket = attachments off.
APP_DST_S3_BUCKET=
APP_DST_S3_REGION=
APP_DST_S3_ENDPOINT_URL=
APP_DST_S3_ADDRESSING_STYLE=path
APP_DST_S3_ACCESS_KEY_ID=
APP_DST_S3_SECRET_ACCESS_KEY=
# Must equal attachment_store.active_store on each chat DB (default: the side name).
APP_DST_STORE_ID=dst
