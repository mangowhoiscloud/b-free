# 예시 값만 둡니다. 실제 값은 비밀 저장소나 .env에 두고 커밋하지 않습니다.
# 상태 머신(platform/api)이 이 서비스를 부를 때 쓰는 토큰. API의 BRAVO_REHEARSAL_API_TOKEN과 같은 값.
BRAVO_REHEARSAL_API_TOKEN=
# Trial 토큰 서명 키(32바이트 이상). 에이전트 워커에는 가지 않습니다.
BRAVO_REHEARSAL_TOKEN_KEY=
# 워커가 도구 계층(/mcp)에 닿는 주소
BRAVO_REHEARSAL_TOOL_LAYER_URL=http://127.0.0.1:8090
# 목적지 클러스터(로컬 K3s on Lima). infra/envs/target-onprem이 만드는 kubeconfig 경로
BRAVO_REHEARSAL_KUBECONFIG=
BRAVO_REHEARSAL_KUBE_CONTEXT=
# 샌드박스와 검증 이미지. digest 고정만 받습니다(image@sha256:<64자리>)
BRAVO_REHEARSAL_SANDBOX_IMAGE=
BRAVO_REHEARSAL_VERIFIER_IMAGE=
# 역할별 허용 목록 폴더(기본: 저장소의 platform/agent/allowlists)
BRAVO_AGENT_ALLOWLISTS_DIR=
# Harbor task 템플릿 폴더(비우면 platform/agent/harbor, 그 다음 tasks/templates를 찾음).
BRAVO_AGENT_HARBOR_DIR=
# Harbor Trial 기록 폴더(비우면 platform/rehearsal/runs).
BRAVO_REHEARSAL_TRIALS_DIR=
# 모델 경로(13-agents 6절). bravo_agents.llm.resolve_llm이 검사하고, 하나라도 없으면 Trial이 llm_unconfigured로 멈춥니다.
# 워커는 이 경로 설정과 Trial 토큰만 받습니다. 모델 키 · 클라우드 자격은 워커에 가지 않습니다.
# 공급자는 환경 변수로만 고릅니다. bravo_agents가 받는 값만 유효합니다(anthropic_gateway, bedrock_gateway, 추가 예정 codex_chatgpt).
BRAVO_LLM_PROVIDER=bedrock_gateway
BRAVO_LLM_GATEWAY_URL=
# Bedrock 도쿄 jp. 추론 프로필(2026-11-02 ap-northeast-1 ACTIVE 확인). 설정만, 이 패키지에서 실호출하지 않음.
BRAVO_MODEL_OPUS=jp.anthropic.claude-opus-5-5
BRAVO_MODEL_HAIKU=jp.anthropic.claude-haiku-5-5
BRAVO_BEDROCK_REGION=ap-northeast-1
# 공급자가 더 필요로 하는 변수 이름(쉼표 구분). 값이 아니라 이름입니다. BRAVO_LLM_* · BRAVO_MODEL_* · BRAVO_BEDROCK_* · BRAVO_CODEX_*는 자동으로 넘어갑니다.
BRAVO_WORKER_ENV_PASSTHROUGH=
# 서버 쪽 도구(D-26). 자격은 플랫폼 OpenBao에서 호출 때 읽고, 결과에 비밀 값을 넣지 않습니다.
BRAVO_GATE_URL=
BRAVO_EVIDENCE_DIR=
BRAVO_OPENBAO_ADDR=
BRAVO_OPENBAO_KV_MOUNT=secret
# OpenBao 인증: 토큰 파일 또는 Kubernetes auth(역할 이름, 마운트, 서비스 계정 JWT 파일)
BRAVO_OPENBAO_TOKEN_FILE=
BRAVO_OPENBAO_K8S_ROLE=
BRAVO_OPENBAO_K8S_MOUNT=kubernetes
BRAVO_OPENBAO_K8S_JWT_FILE=
BRAVO_OPENBAO_CACERT=
# KV v2 경로. {env}는 Trial의 source_env · target_env입니다. 값: host, port, dbname, user, password, sslmode
BRAVO_OPENBAO_DB_RO_PATH=bravo/db/{env}/collector_ro
BRAVO_OPENBAO_DB_SYNTHETIC_PATH=bravo/db/synthetic/rehearse
# 게이트에 인증이 생기면 그 토큰의 경로(값 키: token). 비우면 인증 없이 부릅니다.
BRAVO_OPENBAO_GATE_PATH=
