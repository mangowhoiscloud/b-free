# 예시 값만 둡니다. 실제 값은 비밀 저장소나 .env에 두고 커밋하지 않습니다.
# 상태 머신(platform/api)이 이 서비스를 부를 때 쓰는 토큰. API의 BRAVO_REHEARSAL_API_TOKEN과 같은 값.
BRAVO_REHEARSAL_API_TOKEN=
# Trial 토큰 서명 키(32바이트 이상). 에이전트 워커에는 가지 않습니다.
BRAVO_REHEARSAL_TOKEN_KEY=
# 워커가 도구 계층(/mcp)에 닿는 주소
BRAVO_REHEARSAL_TOOL_LAYER_URL=http://127.0.0.1:8090
# 목적지 클러스터(로컬 K3s on Lima). infra/envs/target-onprem이 만드는 kubeconfig 경로
BRAVO_REHEARSAL_KUBECONFIG=
BRAVO_REHEARSAL_KUBE_CONTEXT=
# 샌드박스와 검증 이미지. digest 고정만 받습니다(image@sha256:<64자리>)
BRAVO_REHEARSAL_SANDBOX_IMAGE=
BRAVO_REHEARSAL_VERIFIER_IMAGE=
# 역할별 허용 목록 폴더(기본: 저장소의 platform/agent/allowlists)
BRAVO_AGENT_ALLOWLISTS_DIR=
# Harbor task 템플릿 폴더(비우면 platform/agent/harbor, 그 다음 tasks/templates를 찾음).
BRAVO_AGENT_HARBOR_DIR=
# Harbor Trial 기록 폴더(비우면 platform/rehearsal/runs).
BRAVO_REHEARSAL_TRIALS_DIR=
# 모델 경로(13-agents 6절). 모든 에이전트는 Agent SDK. bravo_agents.llm.resolve_llm이 검사하고, 없으면 llm_unconfigured.
# 공급자: claude_subscription(기본, 데모: 팀장 구독 토큰, OpenBao secret/envs/platform/llm-claude),
# openai_agents(대체 엔진: OpenAI API 키, OpenBao secret/envs/platform/llm-openai), bedrock_gateway · anthropic_gateway(운영 목표).
# 워커는 자격 값을 받지 않습니다. 서비스가 Trial마다 한 번 쓰는 AppRole secret_id를 넘기고, 워커가 직접 한 번 읽습니다.
BRAVO_LLM_PROVIDER=claude_subscription
BRAVO_MODEL_OPUS=claude-opus-5-5
BRAVO_MODEL_HAIKU=claude-haiku-5-5
# bedrock_gateway일 때: 게이트웨이 주소, jp. 추론 프로필(2026-11-02 ap-northeast-1 ACTIVE 확인), 지역
BRAVO_LLM_GATEWAY_URL=
BRAVO_BEDROCK_REGION=
# 서버 쪽 도구(D-26). 자격은 플랫폼 OpenBao에서 호출 때 읽고, 결과에 비밀 값을 넣지 않습니다.
# 파일럿: http://gate:8084 (compose.gate.yaml, 같은 bravo-pilot 네트워크)
BRAVO_GATE_URL=
BRAVO_EVIDENCE_DIR=
# OpenBao. 변수 이름은 Executor(bravo_executor.vault)와 같습니다. 파일럿: https://platform-bao:8200 + bao/tls/ca.crt
BRAVO_BAO_ADDR=
BRAVO_BAO_CACERT=
BRAVO_BAO_KV_MOUNT=secret
# 인증 셋 중 하나. 파일럿은 AppRole: deploy/pilot/scripts/rehearsal-bao.sh with-rehearsal가 role_id와
# 한 번 쓰는 secret_id(60초)를 이 프로세스 환경에만 넣습니다. 서비스는 시작 때 로그인하고 주기 토큰을 갱신합니다.
BRAVO_BAO_ROLE_ID=
BRAVO_BAO_SECRET_ID=
BRAVO_BAO_TOKEN_FILE=
BRAVO_BAO_K8S_ROLE=
BRAVO_BAO_K8S_MOUNT=kubernetes
BRAVO_BAO_K8S_JWT_FILE=
# KV v2 경로(값 키: host, port, dbname, user, password, sslmode). {env}는 Trial의 source_env · target_env입니다.
BRAVO_BAO_DB_RO_PATH=envs/{env}/collector-ro
BRAVO_BAO_SYNTHETIC_DB_PATH=platform/rehearsal-synthetic-db
BRAVO_BAO_EVIDENCE_DB_PATH=platform/rehearsal-evidence-db
# 게이트에 인증이 생기면 그 토큰의 경로(값 키: token). 비우면 인증 없이 부릅니다.
BRAVO_BAO_GATE_PATH=
