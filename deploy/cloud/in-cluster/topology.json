{
  "label": "D-16 링크(Cloudflare Access, bravo-link)",
  "chat_db": "chat",
  "store_ids": {
    "src": "src",
    "dst": "dst"
  },
  "cluster_names": {
    "src": "chat-db",
    "dst": "chat-db"
  },
  "db": {
    "src": {
      "conninfo": "host=src-db.bravo-link.svc.cluster.local port=5432 sslmode=verify-full sslrootcert=/etc/bravo/kube/source-aws-chat-db.crt",
      "secret": "envs/source-aws/chat-db"
    },
    "dst": {
      "conninfo": "host=dst-db.bravo-link.svc.cluster.local port=5432 sslmode=verify-full sslrootcert=/etc/bravo/kube/target-onprem-chat-db.crt",
      "secret": "envs/target-onprem/chat-db"
    }
  },
  "pools": [
    {
      "name": "src",
      "conninfo": "host=src-pgb.bravo-link.svc.cluster.local port=6432 sslmode=verify-full sslrootcert=/etc/bravo/kube/source-aws-chat-db.crt",
      "secret": "envs/source-aws/chat-db",
      "switch": {
        "kind": "k8s-exec",
        "context": "bravo-source",
        "namespace": "chat",
        "workload": "selector:app.kubernetes.io/name=chat-pgbouncer",
        "container": "pgbouncer"
      }
    },
    {
      "name": "dst",
      "conninfo": "host=dst-pgb.bravo-link.svc.cluster.local port=6432 sslmode=verify-full sslrootcert=/etc/bravo/kube/target-onprem-chat-db.crt",
      "secret": "envs/target-onprem/chat-db",
      "switch": {
        "kind": "k8s-exec",
        "context": "bravo-onprem",
        "namespace": "chat",
        "workload": "selector:app.kubernetes.io/name=chat-pgbouncer",
        "container": "pgbouncer"
      }
    }
  ],
  "entries": [
    {
      "name": "aws",
      "side": "src",
      "url": "http://src-admin.bravo-link.svc.cluster.local:8081",
      "secret": "envs/source-aws/chat-admin"
    },
    {
      "name": "onprem",
      "side": "dst",
      "url": "http://dst-admin.bravo-link.svc.cluster.local:8081",
      "secret": "envs/target-onprem/chat-admin"
    }
  ],
  "object_stores": {
    "src": {
      "secret": "envs/source-aws/object-store"
    },
    "dst": {
      "secret": "envs/target-onprem/object-store",
      "endpoint_url": "https://127.0.0.1:18443",
      "addressing_style": "path"
    }
  },
  "replication": {
    "fwd_conninfo": "host=src-db-link.chat.svc port=5432 sslmode=verify-full sslrootcert=/projected/db-ca/ca.crt",
    "rev_conninfo": "host=dst-db-link.chat.svc port=5432 sslmode=verify-full sslrootcert=/projected/db-ca/ca.crt",
    "label": "D-16 환경 간 링크(cloudflared access tcp, 토큰 dst-src-db / src-dst-db)"
  }
}
