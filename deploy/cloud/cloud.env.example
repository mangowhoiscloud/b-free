# Cloud E2E run settings for the Executor (no secrets; secrets come from the platform OpenBao).
# Copy to deploy/cloud/cloud.env. Names follow deploy/CLOUD-E2E-CONTRACT.md.

# kubectl contexts and namespace (contract §2, §3)
SRC_CONTEXT=bravo-source
DST_CONTEXT=bravo-onprem
CHAT_NAMESPACE=chat
CHAT_DB_NAME=chat
SRC_ENV=source-aws
DST_ENV=target-onprem
# App environment ids (demo app APP_ENV_ID) and attachment store ids
SRC_APP_ENV_ID=aws
DST_APP_ENV_ID=onprem
SRC_STORE_ID=src
DST_STORE_ID=dst

# Cluster object names (contract §3, §9)
DB_RW_SERVICE=svc/chat-db-rw
PGBOUNCER_WORKLOAD=deploy/chat-pgbouncer
PGBOUNCER_SERVICE=svc/chat-pgbouncer
ADMIN_SERVICE=svc/chat-admin
REVERSE_RELAY_WORKLOAD=deploy/dst-db-link
REVERSE_RELAY_SERVICE_HOST=dst-db-link.chat.svc

# Temporary link (contract §7): laptop port-forwards, label recorded on every run
LINK_LABEL=임시 링크(D-16 전)
LINK_BIND=127.0.0.1
LIMA_HOST_NAME=host.lima.internal
SRC_DB_PORT=15432
SRC_DB_REPL_PORT=15433
SRC_DB_APP_PORT=15434
DST_DB_PORT=25432
SRC_PGB_PORT=16432
DST_PGB_PORT=26432
SRC_ADMIN_PORT=18081
DST_ADMIN_PORT=28081
REVERSE_AGENT_PORT=17070
REVERSE_TARGET_PORT=25433

# Ledger is the platform DB used by executor-0 (ledger.sh is a local fallback, not used for demo runs)
LEDGER_PORT=35498
LEDGER_IMAGE=postgres:16.15@sha256:5db6dac2ef5dcff512f4f00a009c3c332b9f2f28f24277175bf3e4a3d02ef83a

# Front (contract §6): the customer app name only. b-free is the platform and is refused.
FRONT_APP=b-free-chat
FRONT_ENV_IDS=src=aws,dst=onprem
FRONT_LB_ENABLED=1

# Load
LOADGEN_RATE=20
DEMO_RATE=2

# Reverse relay image (tools/link/Dockerfile, arm64, platform ECR, pinned by digest)
RELAY_IMAGE=721622471953.dkr.ecr.ap-northeast-2.amazonaws.com/bravo-platform/link@sha256:fabf854f611cc56750d70b338b2a7f23eb18e4ef9ac6e8d1c2adf5fd105e2269
# Destination app workload (Helm release chat, chart apps/demo/chart) for the Exit Drill
APP_WORKLOAD=deploy/chat-bravo-demo

# Platform EKS (OpenBao openbao-0, executor-0 in bravo-control), reached by private port-forwards
PLATFORM_CONTEXT=bravo-platform-rke2
