# Landing zone versions (D-23): the same on every customer cluster. Checked against the official
# releases on 2026-11-02. Images are pinned by digest; charts by exact version.
GATEWAY_API_VERSION=v1.7.0
CILIUM_CHART_VERSION=1.20.4
CNPG_CHART_VERSION=0.29.1
ROOK_CHART_VERSION=v1.21.1
KYVERNO_CHART_VERSION=3.9.2
ESO_CHART_VERSION=2.14.0
OTEL_CHART_VERSION=0.178.1

# PostgreSQL 16 for CNPG chat-db (CNPG "standard" image, multi-arch index digest).
PG_IMAGE=ghcr.io/cloudnative-pg/postgresql:16.15-standard-bookworm@sha256:0c19f66e28154922681fdd316d5a5bf4bfae4799d8943708e25f6fa1676fe300
# Cloudflare connector (multi-arch index digest).
CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared:2026.10.7@sha256:4955524aeaa379e154023d5a027c250f7b35041a2e7e950cf13f144bc9b9c5ba

# Platform-built images. On K3s they are imported into containerd from `docker save` (air-gapped
# style, CLOUD-E2E-CONTRACT §5) under the bravo.local/ name; the digest is the same as on the source.
DEMO_IMAGE_LOCAL=bravo-demo:0.3.0
DEMO_IMAGE_REPO=bravo.local/bravo-demo
DEMO_IMAGE_DIGEST=sha256:df08e969193efd318299864c6fd34e3e6e64c1a8d171e67ebfd109e60477ed57
PGBOUNCER_IMAGE_LOCAL=bravo-pgbouncer:pilot
PGBOUNCER_IMAGE_REPO=bravo.local/bravo-pgbouncer
PGBOUNCER_IMAGE_DIGEST=sha256:68c4a15e2c33f01cd5733e11208d5518a1a4a23aec9ecc4daf49a220792db23c

# Ceph Tentacle 20.2.4 for Rook v1.21.1 (multi-arch index digest).
CEPH_IMAGE=quay.io/ceph/ceph:v20.2.4@sha256:6bb1c8a42fbc0bf87938946990b65174466997bc11c31eb5a323225a779fd8f9

# OTel Collector agent (chart 0.178.1 = collector 0.163.2, k8s distribution, multi-arch index digest).
OTEL_IMAGE_REPO=otel/opentelemetry-collector-k8s
OTEL_IMAGE_DIGEST=sha256:cce4142919331aa26dd9e2900b0583dac12c44d2f87c270d3a2110912d4785a9

