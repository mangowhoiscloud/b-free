# gke overlay pins. Sourced AFTER deploy/landing-zone/versions.env (the shared pins, D-23), so charts and images
# that every cluster runs come from that one file; only GKE-specific names are set here.
OTEL_IMAGE=${OTEL_IMAGE_REPO}@${OTEL_IMAGE_DIGEST}
# App images: the destination registry (Artifact Registry) holds the SAME digest as the source (contract §5).
DEMO_IMAGE_NAME=bravo-demo
DEMO_DIGEST=${DEMO_IMAGE_DIGEST}
PGB_IMAGE_NAME=bravo-pgbouncer
PGB_DIGEST=${PGBOUNCER_IMAGE_DIGEST}
# python3 for the bravo-link relays (tools/link/Dockerfile base, same digest)
LINK_RELAY_IMAGE=python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
# Test pods in verify.sh (NetworkPolicy probes)
NETTEST_IMAGE=busybox:1.37.0@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec
