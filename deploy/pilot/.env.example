# Pilot environment. Copy to deploy/pilot/.env (gitignored) and replace every change-me value.
# Secrets: URL-safe characters only (letters, digits, - _ .). They are placed in libpq
# connection strings and in the PgBouncer auth file (no double quotes).

# --- Data plane, Executor, load generator (compose.data.yaml) ----------------------------
# PostgreSQL 16 Docker Official Image pinned by digest (16.15). The CNPG operand image
# (ghcr.io/cloudnative-pg/postgresql) could not be pulled here (registry: denied).
CHAT_DB_IMAGE=postgres:16.15@sha256:5db6dac2ef5dcff512f4f00a009c3c332b9f2f28f24277175bf3e4a3d02ef83a
CHAT_DB_NAME=chat
# Superuser of src-db and dst-db (init, repl-setup, fix-dst-grant.sql). The Executor never uses it.
POSTGRES_PASSWORD=change-me-postgres
# Chat database roles (CONTRACT.md 3), identical on src and dst.
APP_WRITER_PASSWORD=change-me-app-writer
REPLICATOR_PASSWORD=change-me-replicator
EXECUTOR_CTL_PASSWORD=change-me-executor-ctl
# Observe-only role used by a restarted Executor with unresolved effects (no write rights).
EXECUTOR_OBSERVE_PASSWORD=change-me-executor-observe
# Contract tests only (E1/E6): "<resource>:<action>" makes the Executor exit right after that
# external call returns, before the result is recorded. Leave empty in every other run.
BRAVO_FAULT_CRASH_AFTER=
# Attachment store IDs (D-04): attachment_store.active_store on each chat DB. Must equal the demo
# app's APP_SRC_STORE_ID / APP_DST_STORE_ID (apps/demo/pilot-app.env).
ATTACHMENT_SRC_STORE_ID=src
ATTACHMENT_DST_STORE_ID=dst
# PgBouncer admin console users (CONTRACT.md 4).
PGB_ADMIN_PASSWORD=change-me-pgb-admin
PGB_STATS_PASSWORD=change-me-pgb-stats
# Host ports (CONTRACT.md 2).
SRC_DB_HOST_PORT=15432
DST_DB_HOST_PORT=25432
PGBOUNCER_HOST_PORT=16432
EXECUTOR_HOST_PORT=8081
# Executor -> platform DB. Role bravo_executor (see the Platform section below).
PLATFORM_DB_DSN=postgresql://bravo_executor:change-me-platform-executor@platform-db:5432/bravo
# OTLP/gRPC collector for executor and loadgen spans.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Load generator (compose profile `load`).
LOADGEN_RATE=20
LOADGEN_DURATION_S=60
LOADGEN_CONCURRENCY=8
# Smoke test (scripts/cutover_smoke.sh). Compose files are relative to deploy/pilot.
# SMOKE_SCENARIO: match | mismatch | roundtrip (cutover, load on dst, failback).
SMOKE_COMPOSE_FILES=compose.yaml
SMOKE_PROJECT=bravo-pilot
SMOKE_EXECUTOR_URL=http://localhost:8081
SMOKE_LOAD_DURATION_S=40
SMOKE_CUTOVER_AFTER_S=10
SMOKE_WRITE_PAUSE_BUDGET_MS=5000
# Set inside compose.data.yaml (reference only, not read from this file):
#   chat DBs: BRAVO_SIDE, BRAVO_SCHEMA_DIR | repl-setup: SRC_HOST, DST_HOST, DB_PORT, CHAT_DB, SYNC_TIMEOUT_S
#   pgbouncer-config: CONF_DIR, SEED_INI, PGB_UID, PGB_GID | pgbouncer: PGBOUNCER_INI
#   executor: BRAVO_EXECUTOR_HOST, BRAVO_EXECUTOR_PORT, BRAVO_CHAT_DB, BRAVO_SRC_DSN, BRAVO_DST_DSN,
#     BRAVO_SRC_APP_DSN, BRAVO_PGB_APP_DSN, BRAVO_PGB_ADMIN_DSN, BRAVO_PGB_INI_PATH, BRAVO_PGB_DB_NAME,
#     BRAVO_PGB_SRC_TARGET, BRAVO_PGB_DST_TARGET, BRAVO_SRC_OBSERVE_DSN, BRAVO_DST_OBSERVE_DSN,
#     BRAVO_PGB_STATS_DSN, BRAVO_LOCK_LEASE_S, BRAVO_FAULT_CRASH_AFTER; optional BRAVO_LAG_MAX_BYTES, BRAVO_PAUSE_TIMEOUT_S,
#     BRAVO_BARRIER_TIMEOUT_S, BRAVO_SUBSCRIPTION_TIMEOUT_S, BRAVO_PROBE_TIMEOUT_S, LOG_LEVEL
#   loadgen: LOADGEN_DSN, LOADGEN_VERIFY; optional LOADGEN_VERIFY_DSN, LOADGEN_ATTEMPT_TIMEOUT_S,
#     LOADGEN_MAX_ATTEMPTS, LOADGEN_DRAIN_TIMEOUT_S, LOADGEN_ROOM, LOADGEN_AUTHOR, LOADGEN_ACKED_FILE
#   executor tests: BRAVO_TEST_PG_DSN (throwaway PostgreSQL 16 for ledger/fence tests)

# --- Platform (compose.platform.yaml, platform/api) -----------------------------------
# platform-db: owner runs migrations only; services use the three roles below (no BYPASSRLS).
PLATFORM_DB_NAME=bravo
PLATFORM_DB_HOST_PORT=35432
PLATFORM_DB_OWNER_PASSWORD=change-me-platform-owner
PLATFORM_DB_API_PASSWORD=change-me-platform-api
PLATFORM_DB_MCP_PASSWORD=change-me-platform-mcp
PLATFORM_DB_EXECUTOR_PASSWORD=change-me-platform-executor
# The Executor's PLATFORM_DB_DSN must use role bravo_executor (grants: runs, run_stages, effects, receipts):
#   postgresql://bravo_executor:<PLATFORM_DB_EXECUTOR_PASSWORD>@platform-db:5432/bravo
PLATFORM_API_HOST_PORT=8080
PLATFORM_MCP_HOST_PORT=8082
# Access-style JWT (deploy/pilot/devauth/gen.py signs with the same values).
PLATFORM_JWT_ISSUER=https://bravo-dev.cloudflareaccess.com
PLATFORM_CONSOLE_AUD=console-aud
PLATFORM_MCP_AUD=mcp-aud
PLATFORM_TENANT=t1
# 1 = seed dev principals and serve GET /v1/dev/tokens. Never 1 outside the laptop pilot.
PLATFORM_DEV_AUTH=1
PLATFORM_DEVAUTH_TOKEN_HOURS=12
PLATFORM_EXECUTOR_URL=http://executor:8081
PLATFORM_CONSOLE_BASE_URL=http://localhost:5173
PLATFORM_CORS_ORIGINS=http://localhost:5173
PLATFORM_MCP_ALLOWED_HOSTS=localhost:8082,127.0.0.1:8082,operator-mcp:8082
PLATFORM_MCP_ALLOWED_ORIGINS=
PLATFORM_SSE_TICKET_SECRET=change-me-32-bytes-or-more-random
PLATFORM_GATE_MAX_LAG_BYTES=65536
PLATFORM_GATE_REQUIRED_CONTROLS=DB-ANON-READ,DB-AUTH
PLATFORM_OTEL_ENDPOINT=http://otel-collector:4317

# --- Console (compose.console.yaml) ---
CONSOLE_HOST_PORT=5173
CONSOLE_API_BASE=http://localhost:8080

# --- Observability (compose.yaml) ---
BRAVO_ENV=pilot
GRAFANA_HOST_PORT=3300
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# 외부 자격(사람이 직접 발급해 붙여 넣음, 채팅에 붙이지 않음)
# Cloudflare: 권한 Tunnel · Access 앱/정책 · Access 서비스 토큰 · LB 풀/모니터 · DNS · LB · Zone 읽기, 만료 7일
# 토큰은 첫 부트스트랩에만 넣음. scripts/keys.sh import-cloudflare가 플랫폼 OpenBao로 옮기고 이 값을 비움(D-26, README.md)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# LLM: Anthropic API 키, 또는 AWS 계정 검증이 끝나면 Bedrock 도쿄(jp. 프로필)로 전환
ANTHROPIC_API_KEY=

# Rehearsal service (compose.rehearsal.yaml, platform/rehearsal). Start: scripts/rehearsal-bao.sh with-rehearsal -- docker compose ...
PLATFORM_REHEARSAL_URL=http://rehearsal:8090
REHEARSAL_API_TOKEN=change-me-rehearsal-api
REHEARSAL_TOKEN_KEY=change-me-at-least-32-bytes-rehearsal-trial-key
REHEARSAL_HOST_PORT=8090
# Destination K3s kubeconfig on the host (infra/envs/target-onprem). Empty: Trials refused with cluster_unconfigured.
REHEARSAL_KUBECONFIG_HOST=
REHEARSAL_KUBE_CONTEXT=
# Digest-pinned images the K3s nodes can pull (image@sha256:<64 hex>). Empty: verifier_unconfigured.
REHEARSAL_SANDBOX_IMAGE=
REHEARSAL_VERIFIER_IMAGE=
# DB passwords used only to create the roles; the service reads them from OpenBao (rehearsal-bao.sh put-*).
PLATFORM_DB_REHEARSAL_RO_PASSWORD=change-me-platform-rehearsal-ro
REHEARSAL_SYNTHETIC_ADMIN_PASSWORD=change-me-rehearsal-synthetic-admin
REHEARSAL_SYNTHETIC_RW_PASSWORD=change-me-rehearsal-synthetic-rw
